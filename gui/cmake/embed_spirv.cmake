# Writes a C++ header holding SPIR-V modules as std::uint32_t arrays (G25).
#
#   cmake -DOUTPUT=<header> -DCOMPILER=<what produced them> -DNAMES=ui_vertex;ui_fragment
#         -DFILES=<a.spv>;<b.spv> -P embed_spirv.cmake
#
# The header is committed, so building vio never needs a shader compiler; this script runs only
# when the vio_gui_shaders target regenerates it.

list(LENGTH NAMES count)
list(LENGTH FILES file_count)
if(NOT count EQUAL file_count)
    message(FATAL_ERROR "embed_spirv: NAMES and FILES differ in length")
endif()

set(body "")
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET NAMES ${i} name)
    list(GET FILES ${i} file)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR remainder "${length} % 8")
    if(length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "embed_spirv: ${file} is not a whole number of 32-bit words")
    endif()
    # SPIR-V is a stream of little-endian words: reverse the bytes of each.
    string(REGEX MATCHALL "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" words "${hex}")
    set(line "  ")
    set(lines "")
    set(column 0)
    foreach(word ${words})
        string(SUBSTRING "${word}" 0 2 b0)
        string(SUBSTRING "${word}" 2 2 b1)
        string(SUBSTRING "${word}" 4 2 b2)
        string(SUBSTRING "${word}" 6 2 b3)
        string(APPEND line "0x${b3}${b2}${b1}${b0}u, ")
        math(EXPR column "${column} + 1")
        if(column EQUAL 8)
            string(APPEND lines "${line}\n")
            set(line "  ")
            set(column 0)
        endif()
    endforeach()
    if(NOT column EQUAL 0)
        string(APPEND lines "${line}\n")
    endif()
    string(REPLACE ", \n" ",\n" lines "${lines}")
    string(APPEND body "inline constexpr std::uint32_t ${name}[] = {\n${lines}};\n\n")
endforeach()

file(WRITE "${OUTPUT}" "// Generated by gui/cmake/embed_spirv.cmake -- do not edit. Regenerate with the vio_gui_shaders
// target (G25). Compiled by: ${COMPILER}
#pragma once

#include <cstdint>

namespace vio::gui::ui::detail::shaders
{
${body}} // namespace vio::gui::ui::detail::shaders
")
